<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**</DefaultItemExcludes>
    <UserSecretsId>406c5adb-0784-415c-a87a-65d366bbaeb3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bison.Core\Bison.Core.csproj" />
  </ItemGroup>
    
  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.GitHub" Version="8.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
  <None Include="..\..\data\schema.sql" Link="data\schema.sql" CopyToOutputDirectory="PreserveNewest" />
  <None Include="..\..\data\dump.sql" Link="data\dump.sql" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup>

</Project>
