@page "/obs/{author}"
@model Bison.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    // getting the value of the URL author and store it locally
    // HTTP context -> current HTTP request
    // /obs/author
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    @*Finds observation for the a certain author per request*@
    <h2> @routeName's Observations </h2>

    @*show all observations and list them for the author*@
    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@ob.Author">@ob.Author</a>
                        </strong>
                        @ob.Message
                        <small>&mdash; @ob.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
</div>
