@page "/ob/{id}"
@model Bison.Razor.Pages.DetailModel
@{
    ViewData["Title"] = "Observation details";
    Layout = "Shared/_Layout";
    // getting the value of the URL author and store it locally
    // HTTP context -> current HTTP request
    // /obs/author
    var routeName = HttpContext.GetRouteValue("id");
}

<div>
    @*Finds observation for the a certain author per request*@
    <h2> @routeName's ObservationDetails </h2>

    @*show all observations and list them for the author*@
    @if (Model.ObservationDetails.Any())
    {
        var ob = Model.ObservationDetails[0];

        // THE OBSERVATION
        <div class ="observation">
            <p>
                <strong>/@ob.Author</strong>
                @ob.Message
                <small>&mdash; @ob.Timestamp</small>
            </p>
        </div>

        // COMMENTS
        <div class="comments">
            <h3>Comments for this observation</h3>

            @foreach (var comment in Model.Comments)
            {
            <p>
                <strong>@comment.Author</strong>
                @comment.Message
                <small>&mdash; @comment.Timestamp</small>
            </p>
            }
        </div>

        // PROPOSALS
        <div class="proposals">
            <h3>Proposals for this observation</h3>

        @foreach (var proposal in Model.Proposals)
        {
            <p>
                <strong>@proposal.Author</strong>
                @proposal.Message
                <small>&mdash; @proposal.Timestamp</small>
            </p>
        }
        </div>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
</div>
