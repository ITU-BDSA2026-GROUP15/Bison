@page "/obs"
<!-- associated with the obs URL, must be the very first in the code -->

<!-- The path to the c# code that the html file uses, here Public.cshtml.cs -->
<!-- This means we can access the properties from the class -->
@model Bison.Web.Pages.PublicModel
@{
    // ViewData is used to pass information from Razor page to layout, meaning the title of the browser is now Bison
    ViewData["Title"] = "Bison";

    // basic template for layout of a website
    Layout = "Shared/_Layout";
}

<div>
   <h2>Public Observations</h2>

    @* Vis observationsformularen for indloggede brugere.
    Model.Taxons indeholder valgmulighederne til dropdownen. *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_ObservationForm" model="Model.Taxons" />
    }

    <!-- the if-condition checks if there are any observations to run -->
    @if (Model.Observations.Any())
    {
        // if true, then create a list of the observations
        <ul id="messagelist" class="observations">

            @* now we run through eah observation 1 at a time *@
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        @* now we display the observations and generates a page /obs/author *@
                        <strong>
                            <a href="/obs/@obs.AuthorName">@obs.AuthorName</a>
                        </strong>
                        @*  display the message belonging to the current observation *@
                        @obs.Text
                        <small>&mdash; @obs.TimeStamp</small>
                    </p>
                    @if (obs.PictureUrl != null)
                    {
                        <img class="observation-picture" src=@obs.PictureUrl alt="Picture of the observed animal">
                        @if (obs.License != null)
                        {
                            <partial name="_PictureLicense" model="obs.License" />
                        }
                    }

                    @{
                    // Slå observationens like-antal op. Vis 0, hvis den endnu ikke har likes.
                    var likeCount = Model.LikeStatuses.TryGetValue(obs.Id, out var status) ? status.LikeCount : 0;
                    }
                    <small>@likeCount likes</small>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var isLiked = status?.IsLikedByCurrentUser == true;

                        <form method="post" asp-page="/Public" asp-page-handler="Like">
                            <input type="hidden" name="observationId" value="@obs.Id" />
                            <input type="hidden" name="isLiked" value="@(isLiked ? "false" : "true")" />
                            <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                            <input type="hidden" name="taxonId" value="@Model.CurrentTaxonId" />

                            <button type="submit">@(isLiked ? "♥ Unlike" : "♡ Like")</button>
                        </form>
                    }

                </li>
            }
        </ul>
        <p>
            @if (Model.CurrentPage > 1)
            {
                <a href="/obs?page=@(Model.CurrentPage - 1)@(Model.CurrentTaxonId.HasValue ? "&taxonId=" + Model.CurrentTaxonId : "")">Previous</a>
            }
            <a href="/obs?page=@(Model.CurrentPage + 1)@(Model.CurrentTaxonId.HasValue ? "&taxonId=" + Model.CurrentTaxonId : "")">Next</a>
        </p>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>
