@model IReadOnlyList<Bison.Core.Models.Taxon>

<div class="observationbox">
    <h3>What did you see, @(User.Identity?.Name)?</h3>

    @* Share sender tekst og taxon til CreateObservationModel.OnPost(). *@
    <form method="post" asp-page="/CreateObservation" enctype="multipart/form-data">
        <div asp-validation-summary="All"></div>

        <label for="observation-text">Observation</label>
        @Html.TextBox("Text", null, new
        {
            id = "observation-text",
            required = "required"
        })

        @* Vis navnet på taxonet, men send dets ID. *@
        <label for="observation-taxon">Taxon</label>
        @Html.DropDownList(
            "TaxonId",
            Model.Select(taxon => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem
            {
                Value = taxon.TaxonId.ToString(),
                Text = taxon.VernacularName ?? taxon.dwc_TaxonID
            }),
            "Choose a taxon",
            new
            {
                id = "observation-taxon", required = "required"

            })

        <label for="observation-picture">Add picture (optional)</label>
        <input type="file" id="observation-picture" name="Picture" accept="image/*" />

        @* Licensen er påkrævet, når der er valgt et billede. Tjekkes i CreateObservationModel.OnPostAsync(). *@
        <label for="observation-license">License for the picture (required if you add a picture)</label>
        @Html.DropDownList(
            "License",
            new[] { "CC BY 4.0", "CC BY-SA 4.0", "CC BY-NC 4.0", "CC BY-NC-SA 4.0",
                    "CC BY-ND 4.0", "CC BY-NC-ND 4.0", "CC0 1.0" }
                .Select(license => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem
                {
                    Value = license,
                    Text = license
                }),
            "Choose a license",
            new { id = "observation-license" })

        <input type="submit" value="Share" />
    </form>
</div>
