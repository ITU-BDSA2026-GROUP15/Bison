@model IReadOnlyList<Bison.Web.Models.Taxon>

<div class="proposalbox">
    <h3>What do you propose, @(User.Identity?.Name)?</h3>

    @* Share sender tekst og taxon til CreateObservtionModel.OnPost(). *@
    <form method="post" asp-page="/CreateProposal">
        <div asp-validation-summary="All"></div>

        <input type="hidden" name="ObservationId" value="@ViewData["ObservationId"]" />

        <label for="proposal-text">Proposal</label>
        @Html.TextBox("Text", null, new
        {
            id = "proposal-text",
            required = "required"
        })

        @* Vis navnet på taxonet, men send dets ID. *@
        <label for="proposal-taxon">Taxon</label>
        @Html.DropDownList(
            "TaxonId",
            Model.Select(taxon => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem
            {
                Value = taxon.TaxonId.ToString(),
                Text = taxon.VernacularName ?? taxon.dwc_TaxonID
            }),
            "Choose a taxon",
            new { id = "proposal-taxon", required = "required" })

        <input type="submit" value="Share" />
    </form>
</div>
